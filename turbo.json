{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".node-version", "tsconfig.base.json"],
  "globalEnv": ["MMX_STUDIO_ROOT", "MMX_PROJECT", "MMX_SKIP_BROWSER_E2E", "MMX_E2E_ROOT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "@mmx/desktop#build": {
      "dependsOn": ["@mmx/web#build"],
      "cache": false
    }
  }
}
