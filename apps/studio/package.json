{
  "name": "@mmx/studio",
  "version": "1.0.0",
  "private": true,
  "description": "MMX Studio — Electron + React visual level editor for the deterministic MMX engine.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:web": "vite build --config electron.vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mmx/content-schema": "workspace:*",
    "@mmx/engine": "workspace:*",
    "@mmx/renderer-pixi": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8",
    "dockview-react": "7.0.4",
    "lucide-react": "^1.26.0",
    "monaco-editor": "^0.56.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
