{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@mmx/editor-runtime": ["src/editor-runtime/index.ts"],
      "@mmx/editor-runtime/adapters": ["src/editor-runtime/adapters/index.ts"],
      "@mmx/project-io": ["src/project-io/index.ts"],
      "@mmx/project-io/node": ["src/project-io/node.ts"],
      "@mmx/starter-template": ["src/starter-template/index.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["src/main", "src/preload/generated", "tests"]
}
