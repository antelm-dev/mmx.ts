{
  "name": "mmx.ts",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic Mega Man X gameplay engine with web and desktop clients.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mmx/web dev",
    "play": "pnpm dev",
    "build": "turbo run build --filter=!@mmx/desktop",
    "build:web": "turbo run build --filter=@mmx/web",
    "preview": "pnpm --filter @mmx/web preview",
    "factory:build": "pnpm --filter @mmx/build-tools exec mmx-build build",
    "factory:dev": "pnpm --filter @mmx/build-tools exec mmx-build dev",
    "start": "pnpm preview",
    "desktop:dev": "pnpm --filter @mmx/desktop dev",
    "desktop:build": "turbo run build --filter=@mmx/desktop",
    "sim": "pnpm --filter @mmx/sim start",
    "replay": "pnpm --filter @mmx/sim replay",
    "level:export": "pnpm --filter @mmx/ldtk-tools run export",
    "level:import": "pnpm --filter @mmx/ldtk-tools run import",
    "level:check": "pnpm level:import && git diff --exit-code -- packages/engine/src/game/levels",
    "enemies:import": "node scripts/build-enemies.mjs",
    "pickups:import": "node scripts/build-pickups.mjs",
    "test": "turbo run test",
    "lint": "oxlint --ignore-pattern scripts/__fixtures__/import-boundaries/forbidden/** packages apps scripts && node scripts/check-forbidden-imports.mjs && node --test scripts/import-boundaries.test.mjs",
    "lint:fix": "oxlint --fix --ignore-pattern scripts/__fixtures__/import-boundaries/forbidden/** packages apps scripts",
    "test:import-boundaries": "node --test scripts/import-boundaries.test.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "version:enter-next": "changeset pre enter next",
    "version:exit-next": "changeset pre exit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "turbo": "2.10.7",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.28.2"
}
