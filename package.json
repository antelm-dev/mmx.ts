{
  "name": "mmx.ts",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic Mega Man X gameplay engine with web client.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mmx/web dev",
    "play": "pnpm dev",
    "demo": "pnpm factory:dev -- --project ../mmx-studio/templates/mmx-demo",
    "build": "turbo run build --filter=!@mmx/web && pnpm --filter @mmx/web run typecheck",
    "build:web": "turbo run build --filter=@mmx/web",
    "preview": "pnpm --filter @mmx/web preview",
    "factory:build": "pnpm --filter @mmx/build-tools run cli build",
    "factory:dev": "pnpm --filter @mmx/build-tools run cli dev",
    "start": "pnpm preview",
    "sim": "pnpm --filter @mmx/sim start",
    "replay": "pnpm --filter @mmx/sim replay",
    "test": "turbo run test",
    "lint": "oxlint --ignore-pattern scripts/__fixtures__/import-boundaries/forbidden/** --ignore-pattern scripts/__fixtures__/game-resource-guard/** packages apps scripts && node scripts/check-forbidden-imports.mjs && node scripts/check-game-resources.mjs && node --test scripts/import-boundaries.test.mjs && node --test scripts/game-resource-guard.test.mjs && node --test scripts/web-artifact-contract.test.mjs && node --test scripts/cross-repo-e2e-harness.test.mjs",
    "lint:fix": "oxlint --fix --ignore-pattern scripts/__fixtures__/import-boundaries/forbidden/** packages apps scripts",
    "test:import-boundaries": "node --test scripts/import-boundaries.test.mjs",
    "test:game-resource-guard": "node --test scripts/game-resource-guard.test.mjs",
    "test:cross-repo": "node --test scripts/cross-repo-e2e-harness.test.mjs scripts/cross-repo-e2e.test.mjs",
    "test:web-artifact-contract": "node --test scripts/web-artifact-contract.test.mjs",
    "playwright:install": "playwright install chromium",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "version:enter-next": "changeset pre enter next",
    "version:exit-next": "changeset pre exit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "playwright": "1.55.0",
    "turbo": "2.10.7",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.28.2"
}
