{
  "name": "mmx.ts",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic Mega Man X gameplay engine with web and desktop clients.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mmx/web dev",
    "play": "pnpm dev",
    "studio": "pnpm --filter @mmx/studio dev",
    "studio:build": "turbo run build --filter=@mmx/studio",
    "studio:test": "turbo run test --filter=@mmx/studio",
    "studio:typecheck": "turbo run typecheck --filter=@mmx/studio",
    "build": "turbo run build --filter=!@mmx/desktop --filter=!@mmx/studio",
    "build:web": "turbo run build --filter=@mmx/web",
    "preview": "pnpm --filter @mmx/web preview",
    "start": "pnpm preview",
    "desktop:dev": "pnpm --filter @mmx/desktop dev",
    "desktop:build": "turbo run build --filter=@mmx/desktop",
    "sim": "pnpm --filter @mmx/sim start",
    "replay": "pnpm --filter @mmx/sim replay",
    "level:export": "pnpm --filter @mmx/ldtk-tools run export",
    "level:import": "pnpm --filter @mmx/ldtk-tools run import",
    "level:check": "pnpm level:import && git diff --exit-code -- packages/engine/src/game/levels",
    "enemies:import": "node scripts/build-enemies.mjs",
    "pickups:import": "node scripts/build-pickups.mjs",
    "test": "turbo run test --filter=!@mmx/studio --filter=!@mmx/slope-tools",
    "lint": "oxlint packages apps scripts && node scripts/check-forbidden-imports.mjs && node --test scripts/import-boundaries.test.mjs",
    "lint:fix": "oxlint --fix packages apps scripts",
    "test:import-boundaries": "node --test scripts/import-boundaries.test.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "turbo": "2.10.7",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.28.2"
}
