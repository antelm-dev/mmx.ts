{
  "name": "@mmx/ldtk-tools",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./slopeBake": {
      "types": "./dist/slopeBake.d.ts",
      "import": "./dist/slopeBake.js",
      "default": "./dist/slopeBake.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "export": "tsx src/export.ts",
    "import": "tsx src/import.ts"
  },
  "dependencies": {
    "@mmx/content-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
