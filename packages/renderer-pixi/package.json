{
  "name": "@mmx/renderer-pixi",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "assets"],
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "build": "pnpm run sync-assets && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@mmx/asset-schema": "workspace:*",
    "@mmx/content-schema": "workspace:*",
    "@mmx/engine": "workspace:*"
  },
  "peerDependencies": {
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pixi.js": "^8.19.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
