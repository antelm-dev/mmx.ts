{
  "name": "@mmx/engine",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core/*.js": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js",
      "default": "./dist/core/*.js"
    },
    "./game/*.js": {
      "types": "./dist/game/*.d.ts",
      "import": "./dist/game/*.js",
      "default": "./dist/game/*.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js",
      "default": "./dist/content/index.js"
    },
    "./content/*.js": {
      "types": "./dist/content/*.d.ts",
      "import": "./dist/content/*.js",
      "default": "./dist/content/*.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./data/*.js": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js",
      "default": "./dist/data/*.js"
    },
    "./behaviors": {
      "types": "./dist/behaviors/index.d.ts",
      "import": "./dist/behaviors/index.js",
      "default": "./dist/behaviors/index.js"
    },
    "./behaviors/*.js": {
      "types": "./dist/behaviors/*.d.ts",
      "import": "./dist/behaviors/*.js",
      "default": "./dist/behaviors/*.js"
    },
    "./tooling": {
      "types": "./dist/tooling/index.d.ts",
      "import": "./dist/tooling/index.js",
      "default": "./dist/tooling/index.js"
    },
    "./tooling/*.js": {
      "types": "./dist/tooling/*.d.ts",
      "import": "./dist/tooling/*.js",
      "default": "./dist/tooling/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@mmx/asset-schema": "workspace:*",
    "@mmx/content-contracts": "workspace:*"
  },
  "devDependencies": {
    "@mmx/ldtk-tools": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
