{
  "name": "@mmx/build-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Studio export loader and Vite build factory for MMX web games.",
  "bin": {
    "mmx-build": "./dist/cli/mmx-build.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/plugin.d.ts",
      "import": "./dist/vite/plugin.js",
      "default": "./dist/vite/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@mmx/browser-audio": "workspace:*",
    "@mmx/content-schema": "workspace:*",
    "@mmx/engine": "workspace:*",
    "@mmx/project-schema": "workspace:*",
    "@mmx/renderer-pixi": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "peerDependencies": {
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
