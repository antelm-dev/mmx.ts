{
  "name": "@mmx/editor-runtime",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@mmx/browser-input": "workspace:*",
    "@mmx/content-schema": "workspace:*",
    "@mmx/engine": "workspace:*",
    "@mmx/renderer-pixi": "workspace:*",
    "@mmx/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pixi.js": "^8.19.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "pixi.js": "^8.19.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
